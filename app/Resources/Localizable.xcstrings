                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg more cells"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ cells hold bytes that aren’t %@ text, the first at %@, so they can’t be converted. Leal never replaces them." : {
