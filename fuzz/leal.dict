# libFuzzer dictionary for every target: CSV structure, BOMs, and the
# marker that starts an edit script (src/harness.rs).
edits="\x00EDITS\x00"
utf8_bom="\xEF\xBB\xBF"
utf16le_bom="\xFF\xFE"
utf16be_bom="\xFE\xFF"
crlf="\x0D\x0A"
utf16le_crlf="\x0D\x00\x0A\x00"
utf16be_crlf="\x00\x0D\x00\x0A"
utf16le_quote="\x22\x00"
utf16be_quote="\x00\x22"
escaped_quote="\x22\x22"
quoted_empty="\x22\x22,"
close_then_text="\x22x"
quoted_crlf="\x22\x0D\x0A\x22"
lone_surrogate_le="\x00\xD8"
lone_surrogate_be="\xD8\x00"
utf8_e_acute="\xC3\xA9"
utf8_euro="\xE2\x82\xAC"
invalid_utf8="\xC3\x28"
nul="\x00"
