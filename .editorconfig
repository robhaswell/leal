root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test fixtures must stay byte-exact
[tests/corpus/**]
end_of_line = unset
insert_final_newline = unset
charset = unset
trim_trailing_whitespace = unset
indent_style = unset
